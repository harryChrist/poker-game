# Porta do servidor
PORT=4080
# Caminho do banco SQLite (arquivo local, criado automaticamente)
DB_PATH=./data/cartas.db
# Fichas ao criar a conta
START_BALANCE=10000
# Recarga grátis: leva o total a REFILL_TO quando saldo + fichas em jogo < REFILL_THRESHOLD
REFILL_TO=10000
REFILL_THRESHOLD=1000
# Intervalo mínimo entre recargas (minutos)
REFILL_COOLDOWN_MIN=10
# Bônus diário (1x a cada 24h)
DAILY_BONUS=1000
# Usuários que viram admin ao registrar/entrar (separados por vírgula). O primeiro usuário registrado já é admin.
ADMIN_USERNAMES=
# Pastas servidas (padrão: apps/client/dist em "/" e apps/desktop/release em "/desktop/")
# PUBLIC_DIR=
# DESKTOP_DIR=
# Deploy automático via webhook do GitHub (POST /api/deploy/github). Vazio = desligado.
# Gere um segredo forte (ex.: openssl rand -hex 32) e use o MESMO no webhook do GitHub.
DEPLOY_WEBHOOK_SECRET=
# DEPLOY_BRANCH=main
